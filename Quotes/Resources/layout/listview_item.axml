<?xml version="1.0" encoding="utf-8"?>
<TextView   xmlns:item="http://schemas.android.com/apk/res/android"
            xmlns:tools="http://schemas.android.com/tools"
      item:id="@android:id/text1"
      item:gravity="center"
      item:textAllCaps="false"
      item:fontFamily="casual"
      item:textStyle="bold"
      item:textSize="@dimen/list_item_textsize"
      item:layout_margin="@dimen/large_widget_margin"
      item:padding="@dimen/list_item_padding_normal"
      item:layout_height="@dimen/list_item_height"
      item:layout_width="match_parent" />
  

